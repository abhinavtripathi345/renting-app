# ==========================================
# RENTING APP - GLOBAL ENVIRONMENT CONFIG
# ==========================================

# Port configuration
PORT=4000
NODE_ENV=development

# Database connection (PostgreSQL or SQLite fallback)
# For local Docker postgres:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/renting_app_db?schema=public"
# For zero-config local SQLite fallback:
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="renting_app_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="renting_app_super_secret_refresh_jwt_key_2026"
JWT_REFRESH_EXPIRES_IN="30d"

# Default City for MVP Demo
DEFAULT_CITY="Chandigarh"

# Razorpay / Payment Gateway Sandbox (Mock or Real Sandbox)
RAZORPAY_KEY_ID="rzp_test_mock_key_12345"
RAZORPAY_KEY_SECRET="rzp_test_mock_secret_67890"

# File Upload / Storage Configuration
UPLOAD_DIR="./uploads"
STORAGE_BASE_URL="http://localhost:4000/uploads"

# Admin / Web URL
ADMIN_WEB_URL="http://localhost:3000"
MOBILE_APP_URL="http://localhost:8081"
